# Скопируйте этот файл в .env и заполните значениями.
# .env не попадает в git — реальные ключи и токены храните только там.

# Токен Telegram-бота (получить у @BotFather). Обязательная переменная.
BOT_TOKEN=

# Подключение к базе данных.
# Продакшен (PostgreSQL): postgresql+asyncpg://user:password@localhost:5432/linguflame
# Разработка (SQLite):    sqlite+aiosqlite:///./linguflame.db
DATABASE_URL=sqlite+aiosqlite:///./linguflame.db

# Redis (FSM-хранилище и планировщик)
REDIS_URL=redis://localhost:6379/0

# ИИ (OpenRouter, OpenAI-совместимый API)
# Ключ: https://openrouter.ai/keys. Модель: любая из каталога OpenRouter.
AI_SERVER_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-super-vl:free

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
