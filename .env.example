# Скопируйте этот файл в .env и заполните значениями.
# .env не попадает в git — реальные ключи и токены храните только там.

# Токен Telegram-бота (получить у @BotFather). Обязательная переменная.
BOT_TOKEN=

# Подключение к базе данных.
# Продакшен (PostgreSQL): postgresql+asyncpg://user:password@localhost:5432/linguflame
# Разработка (SQLite):    sqlite+aiosqlite:///./linguflame.db
DATABASE_URL=sqlite+aiosqlite:///./linguflame.db

# Redis (FSM-хранилище и планировщик)
REDIS_URL=redis://localhost:6379/0

# ИИ (OpenRouter, OpenAI-совместимый API)
# Ключ: https://openrouter.ai/keys. Модель: любая из каталога OpenRouter.
AI_SERVER_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-super-vl:free

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Ручная проверка напоминаний: сдвиг времени планировщика в часах.
# 0 — обычное время. Например, +5 сделает вечернее напоминание на 5 часов раньше.
REMINDER_HOUR_OFFSET=0

# JSON-логи: true для продакшена, false для читаемой разработки.
LOG_JSON=false

# Дневной лимит запросов к ИИ на пользователя (0 — без лимита).
AI_DAILY_LIMIT=100

# Режим работы: polling (по умолчанию) или webhook.
BOT_MODE=polling
# Нужны только для BOT_MODE=webhook. Адрес должен быть публичным HTTPS.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# PostgreSQL для docker compose (локальные значения по умолчанию).
POSTGRES_USER=linguflame
POSTGRES_PASSWORD=linguflame
POSTGRES_DB=linguflame
