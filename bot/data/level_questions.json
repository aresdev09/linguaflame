    {"kind": "grammar", "level": "C1", "text": "The plan is ambitious; ___, it is feasible.", "options": {"A": "therefore", "B": "moreover", "C": "nevertheless"}, "correct_option": "C", "explanation": "Nevertheless — тем не менее, вводит уступку."},
    {"kind": "grammar", "level": "C1", "text": "___ I known earlier, I would have acted differently.", "options": {"A": "Have", "B": "Had", "C": "If"}, "correct_option": "B", "explanation": "Инверсия в Third Conditional: Had I known = If I had known."},
    {"kind": "vocabulary", "level": "C1", "text": "The evidence was ___.", "options": {"A": "compelling", "B": "compulsory", "C": "complacent"}, "correct_option": "A", "explanation": "Compelling evidence — убедительные доказательства."},
