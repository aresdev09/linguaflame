    {"kind": "vocabulary", "level": "B2", "text": "The news was ___ by all major channels.", "options": {"A": "cooked", "B": "counted", "C": "covered"}, "correct_option": "C", "explanation": "Cover the news — освещать новость."},
    {"kind": "vocabulary", "level": "B2", "text": "The government introduced a new ___.", "options": {"A": "policy", "B": "police", "C": "polite"}, "correct_option": "A", "explanation": "Policy — политика, курс действий."},
    {"kind": "vocabulary", "level": "B2", "text": "The researchers conducted an ___.", "options": {"A": "experience", "B": "experiment", "C": "expectation"}, "correct_option": "B", "explanation": "Conduct an experiment — проводить эксперимент."},
    {"kind": "vocabulary", "level": "B2", "text": "___ a risk", "options": {"A": "do", "B": "make", "C": "take"}, "correct_option": "C", "explanation": "Устойчивое сочетание: take a risk."},
    {"kind": "vocabulary", "level": "B2", "text": "It's a piece of ___.", "options": {"A": "cake", "B": "bread", "C": "pie"}, "correct_option": "A", "explanation": "A piece of cake — очень простое дело."},
    {"kind": "vocabulary", "level": "B2", "text": "The meeting was ___ until next week.", "options": {"A": "put on", "B": "put up", "C": "put off"}, "correct_option": "C", "explanation": "Put off — отложить."},
    {"kind": "vocabulary", "level": "B2", "text": "The ___ of the project took two years.", "options": {"A": "complete", "B": "completion", "C": "completed"}, "correct_option": "B", "explanation": "Нужно существительное completion — завершение."},
