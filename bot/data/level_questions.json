    {"kind": "grammar", "level": "B2", "text": "She stopped ___ sugar last year.", "options": {"A": "to eat", "B": "eating", "C": "eat"}, "correct_option": "B", "explanation": "Stop + gerund означает прекратить действие."},
    {"kind": "grammar", "level": "B2", "text": "___ unemployment is a serious problem.", "options": {"A": "The", "B": "A", "C": "— (без артикля)"}, "correct_option": "C", "explanation": "Неисчисляемое существительное в общем значении употребляется без артикля."},
    {"kind": "grammar", "level": "B2", "text": "___ the bad weather, we enjoyed the trip.", "options": {"A": "Despite", "B": "Although", "C": "However"}, "correct_option": "A", "explanation": "Despite + существительное; although требует придаточное."},
    {"kind": "vocabulary", "level": "B2", "text": "The company's success depends on its ability to ___ to change.", "options": {"A": "adapt", "B": "adopt", "C": "adept"}, "correct_option": "A", "explanation": "Adapt to — приспосабливаться к."},
