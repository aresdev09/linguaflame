    {"kind": "grammar", "level": "B2", "text": "___ unemployment is a serious problem.", "options": {"A": "The", "B": "A", "C": "— (artikelsiz)"}, "correct_option": "C", "explanation": "Umumiy ma'nodagi sanalmaydigan ot artiklsiz ishlatiladi."},
    {"kind": "grammar", "level": "B2", "text": "___ the bad weather, we enjoyed the trip.", "options": {"A": "Despite", "B": "Although", "C": "However"}, "correct_option": "A", "explanation": "Despite + ot; although tobe ergash gap talab qiladi."},
    {"kind": "vocabulary", "level": "B2", "text": "The company's success depends on its ability to ___ to change.", "options": {"A": "adapt", "B": "adopt", "C": "adept"}, "correct_option": "A", "explanation": "Adapt to — moslashmoq."},
    {"kind": "vocabulary", "level": "B2", "text": "Carbon emissions contribute ___ climate change.", "options": {"A": "for", "B": "to", "C": "with"}, "correct_option": "B", "explanation": "Contribute to — hissa qo'shmoq."},
    {"kind": "vocabulary", "level": "B2", "text": "The news was ___ by all major channels.", "options": {"A": "cooked", "B": "counted", "C": "covered"}, "correct_option": "C", "explanation": "Cover the news — yangilikni yoritmoq."},
    {"kind": "vocabulary", "level": "B2", "text": "The government introduced a new ___.", "options": {"A": "policy", "B": "police", "C": "polite"}, "correct_option": "A", "explanation": "Policy — siyosat, yo'nalish."},
    {"kind": "vocabulary", "level": "B2", "text": "The researchers conducted an ___.", "options": {"A": "experience", "B": "experiment", "C": "expectation"}, "correct_option": "B", "explanation": "Conduct an experiment — tajriba o'tkazmoq."},
    {"kind": "vocabulary", "level": "B2", "text": "___ a risk", "options": {"A": "do", "B": "make", "C": "take"}, "correct_option": "C", "explanation": "Barqaror birikma: take a risk."},
    {"kind": "vocabulary", "level": "B2", "text": "It's a piece of ___.", "options": {"A": "cake", "B": "bread", "C": "pie"}, "correct_option": "A", "explanation": "A piece of cake — juda oson ish."},
    {"kind": "vocabulary", "level": "B2", "text": "The meeting was ___ until next week.", "options": {"A": "put on", "B": "put up", "C": "put off"}, "correct_option": "C", "explanation": "Put off — kechiktirmoq."},
    {"kind": "vocabulary", "level": "B2", "text": "The ___ of the project took two years.", "options": {"A": "complete", "B": "completion", "C": "completed"}, "correct_option": "B", "explanation": "completion oti kerak — tugatish, yakunlash."},
    {"kind": "vocabulary", "level": "B2", "text": "We would like to ___ your application.", "options": {"A": "know", "B": "notice", "C": "acknowledge"}, "correct_option": "C", "explanation": "Acknowledge — olganini tasdiqlamoq."},
    {"kind": "vocabulary", "level": "B2", "text": "Another word for «significant» is ___.", "options": {"A": "considerable", "B": "tiny", "C": "irrelevant"}, "correct_option": "A", "explanation": "Considerable — salmoqli, sezilarli."},
    {"kind": "vocabulary", "level": "B2", "text": "It is highly ___ that the team will win.", "options": {"A": "famous", "B": "likely", "C": "tired"}, "correct_option": "B", "explanation": "Highly likely — juda ehtimoli yuqori."},
    {"kind": "vocabulary", "level": "B2", "text": "We must ___ into account the risks.", "options": {"A": "make", "B": "do", "C": "take"}, "correct_option": "C", "explanation": "Take into account — hisobga olmoq."},
    {"kind": "vocabulary", "level": "B2", "text": "His argument was completely ___.", "options": {"A": "illogical", "B": "logic", "C": "logically"}, "correct_option": "A", "explanation": "illogical sifati kerak — mantiqsiz."},
    {"kind": "vocabulary", "level": "B2", "text": "The opposite of «abundant» is ___.", "options": {"A": "plenty", "B": "scarce", "C": "rich"}, "correct_option": "B", "explanation": "Abundant — mo'l, scarce — taqchil."},
    {"kind": "grammar", "level": "C1", "text": "Rarely ___ such dedication.", "options": {"A": "do we see", "B": "we see", "C": "we do see"}, "correct_option": "A", "explanation": "Rarely ravishi dan keyin inversiya ishlatiladi."},
    {"kind": "grammar", "level": "C1", "text": "It was in Paris ___ they met.", "options": {"A": "which", "B": "where", "C": "that"}, "correct_option": "C", "explanation": "Cleft sentence: It was ... that ..."},
    {"kind": "grammar", "level": "C1", "text": "I suggest that he ___ the offer.", "options": {"A": "accepts", "B": "accepted", "C": "accept"}, "correct_option": "C", "explanation": "suggest that dan keyin subjunktiv — fe'lning asosiy shakli."},
    {"kind": "grammar", "level": "C1", "text": "She ___ have forgotten; she never forgets.", "options": {"A": "mustn't", "B": "can't", "C": "shouldn't"}, "correct_option": "B", "explanation": "Can't have + past participle — bunday bo'lmaganiga ishonchni bildiradi."},
    {"kind": "grammar", "level": "C1", "text": "If he were more careful, he ___ so many mistakes.", "options": {"A": "didn't make", "B": "won't make", "C": "wouldn't make"}, "correct_option": "C", "explanation": "Second Conditional: would + fe'l."},
    {"kind": "grammar", "level": "C1", "text": "The proposal ___ by the committee at the moment.", "options": {"A": "is reviewing", "B": "has reviewed", "C": "is being reviewed"}, "correct_option": "C", "explanation": "Present Continuous Passive: is being + past participle."},
    {"kind": "grammar", "level": "C1", "text": "___ the report, she emailed it to her manager.", "options": {"A": "Finished", "B": "Having finished", "C": "Finish"}, "correct_option": "B", "explanation": "Perfect participle clause — oldinroq tugagan harakatni ko'rsatadi."},
    {"kind": "grammar", "level": "C1", "text": "The ___ of the new law caused protests.", "options": {"A": "introduce", "B": "introduced", "C": "introduction"}, "correct_option": "C", "explanation": "introduction oti kerak."},
    {"kind": "grammar", "level": "C1", "text": "She can play the piano, and her sister ___ too.", "options": {"A": "is", "B": "can", "C": "does"}, "correct_option": "B", "explanation": "Ellips: can — can play o'rnini bosadi."},
    {"kind": "grammar", "level": "C1", "text": "The reason ___ he left remains unclear.", "options": {"A": "which", "B": "why", "C": "that"}, "correct_option": "B", "explanation": "The reason why — barqaror konstruksiya."},
    {"kind": "grammar", "level": "C1", "text": "Not only ___ late, but he also forgot the documents.", "options": {"A": "he was", "B": "he is", "C": "was he"}, "correct_option": "C", "explanation": "Not only dan keyin inversiya ishlatiladi."},
    {"kind": "grammar", "level": "C1", "text": "I wish I ___ speak French fluently.", "options": {"A": "can", "B": "could", "C": "will"}, "correct_option": "B", "explanation": "Wish + could — hozirgi holat haqidagi istakni bildiradi."},
    {"kind": "grammar", "level": "C1", "text": "___ to the gym regularly improves your health.", "options": {"A": "Go", "B": "Gone", "C": "Going"}, "correct_option": "C", "explanation": "Going gerund ega vazifasini o'taydi."},
    {"kind": "grammar", "level": "C1", "text": "The plan is ambitious; ___, it is feasible.", "options": {"A": "therefore", "B": "moreover", "C": "nevertheless"}, "correct_option": "C", "explanation": "Nevertheless — shunga qaramay, zidlikni kiritadi."},
    {"kind": "grammar", "level": "C1", "text": "___ I known earlier, I would have acted differently.", "options": {"A": "Have", "B": "Had", "C": "If"}, "correct_option": "B", "explanation": "Third Conditional'da inversiya: Had I known = If I had known."},
    {"kind": "vocabulary", "level": "C1", "text": "The evidence was ___.", "options": {"A": "compelling", "B": "compulsory", "C": "complacent"}, "correct_option": "A", "explanation": "Compelling evidence — ishonchli dalillar."},
    {"kind": "vocabulary", "level": "C1", "text": "To cut corners means to ___.", "options": {"A": "turn a corner", "B": "do something poorly to save time", "C": "reduce prices"}, "correct_option": "B", "explanation": "Cut corners — vaqtni tejash uchun sifatsiz ish qilish."},
    {"kind": "vocabulary", "level": "C1", "text": "___ a conclusion", "options": {"A": "make", "B": "do", "C": "draw"}, "correct_option": "C", "explanation": "Barqaror birikma: draw a conclusion."},
    {"kind": "vocabulary", "level": "C1", "text": "The scandal ___ widespread criticism.", "options": {"A": "gave rise to", "B": "gave up", "C": "gave away"}, "correct_option": "A", "explanation": "Give rise to — sabab bo'lmoq, keltirib chiqarmoq."},
    {"kind": "vocabulary", "level": "C1", "text": "The study's findings are ___ with previous research.", "options": {"A": "persistent", "B": "consistent", "C": "resistant"}, "correct_option": "B", "explanation": "Consistent with — mos keluvchi, muvofiq."},
    {"kind": "vocabulary", "level": "C1", "text": "We regret to ___ you that your application was unsuccessful.", "options": {"A": "tell", "B": "say", "C": "inform"}, "correct_option": "C", "explanation": "Rasmiy stil: inform somebody."},
    {"kind": "vocabulary", "level": "C1", "text": "The project is still in its ___.", "options": {"A": "infancy", "B": "childhood", "C": "baby"}, "correct_option": "A", "explanation": "In its infancy — rivojlanishning ilk bosqichida."},
    {"kind": "vocabulary", "level": "C1", "text": "The ___ of the data revealed a trend.", "options": {"A": "analyse", "B": "analysis", "C": "analytical"}, "correct_option": "B", "explanation": "analysis oti kerak."},
    {"kind": "vocabulary", "level": "C1", "text": "Another word for «meticulous» is ___.", "options": {"A": "careless", "B": "quick", "C": "thorough"}, "correct_option": "C", "explanation": "Meticulous — juda sinchkov, thorough."},
    {"kind": "vocabulary", "level": "C1", "text": "___ a compromise", "options": {"A": "arrive", "B": "reach", "C": "get"}, "correct_option": "B", "explanation": "Reach a compromise — murosaga kelmoq."},
    {"kind": "vocabulary", "level": "C1", "text": "To be on the fence means to be ___.", "options": {"A": "angry", "B": "confident", "C": "undecided"}, "correct_option": "C", "explanation": "On the fence — qarorga kelmagan, ikkilanayotgan."},
    {"kind": "vocabulary", "level": "C1", "text": "The new evidence ___ his innocence.", "options": {"A": "points to", "B": "points at", "C": "points out"}, "correct_option": "A", "explanation": "Point to — dalolat bermoq."},
    {"kind": "vocabulary", "level": "C1", "text": "He spoke with great ___.", "options": {"A": "convict", "B": "convincingly", "C": "conviction"}, "correct_option": "C", "explanation": "With great conviction — katta ishonch bilan."},
    {"kind": "vocabulary", "level": "C1", "text": "The government's response was widely ___.", "options": {"A": "criticism", "B": "criticized", "C": "critic"}, "correct_option": "B", "explanation": "Passivda fe'l kerak: was criticized."},
    {"kind": "vocabulary", "level": "C1", "text": "___ a distinction", "options": {"A": "draw", "B": "do", "C": "take"}, "correct_option": "A", "explanation": "Draw a distinction — farqlamoq, tafovut o'tkazmoq."},
    {"kind": "grammar", "level": "C2", "text": "Under no circumstances ___ the door be opened.", "options": {"A": "should", "B": "it should", "C": "should it"}, "correct_option": "A", "explanation": "Under no circumstances dan keyin inversiya: should the door be opened."},
    {"kind": "grammar", "level": "C2", "text": "Were it not for her support, I ___ succeeded.", "options": {"A": "will never have", "B": "had never", "C": "would never have"}, "correct_option": "C", "explanation": "Were it not for = If it were not for; keyin would have + past participle."},
    {"kind": "grammar", "level": "C2", "text": "The meeting ___, everyone left.", "options": {"A": "over", "B": "being over", "C": "was over"}, "correct_option": "B", "explanation": "Absolute construction: The meeting being over = uchrashuv tugagach."},
    {"kind": "grammar", "level": "C2", "text": "So intense ___ that we had to leave.", "options": {"A": "the heat was", "B": "had the heat", "C": "was the heat"}, "correct_option": "C", "explanation": "So + sifatdan keyin inversiya: so intense was the heat."},
    {"kind": "grammar", "level": "C2", "text": "You ___ have told me — I had no idea.", "options": {"A": "might", "B": "should", "C": "must"}, "correct_option": "B", "explanation": "Should have + past participle — tanbeh bildiradi."},
    {"kind": "grammar", "level": "C2", "text": "He is said ___ abroad for years.", "options": {"A": "to have lived", "B": "to live", "C": "living"}, "correct_option": "A", "explanation": "Passive reporting: is said to have lived — harakat o'tmishga tegishli."},
    {"kind": "grammar", "level": "C2", "text": "What surprised me ___ his honesty.", "options": {"A": "were", "B": "is", "C": "was"}, "correct_option": "C", "explanation": "Ega vazifasidagi what-clause birlik son bilan kelishadi; o'tmish konteksti — was."},
    {"kind": "grammar", "level": "C2", "text": "Hardly ___ when the phone rang.", "options": {"A": "I had sat down", "B": "had I sat down", "C": "did I sit"}, "correct_option": "B", "explanation": "Hardly dan keyin inversiya: had I sat down."},
    {"kind": "grammar", "level": "C2", "text": "She didn't attend, nor ___ her brother.", "options": {"A": "didn't", "B": "was", "C": "did"}, "correct_option": "C", "explanation": "nor dan keyin inkorsiz inversiya: nor did her brother."},
    {"kind": "grammar", "level": "C2", "text": "But for your help, we ___ lost.", "options": {"A": "would have been", "B": "will be", "C": "had been"}, "correct_option": "A", "explanation": "But for = If it had not been for; keyin would have been."},
    {"kind": "grammar", "level": "C2", "text": "I'd rather you ___ smoke here.", "options": {"A": "don't", "B": "didn't", "C": "won't"}, "correct_option": "B", "explanation": "I'd rather + subject + Past Simple."},
    {"kind": "grammar", "level": "C2", "text": "___ the truth, he decided to confess.", "options": {"A": "Discovered", "B": "Discovering", "C": "Having discovered"}, "correct_option": "C", "explanation": "Perfect participle — harakat oldinroq tugaganini ko'rsatadi."},
    {"kind": "grammar", "level": "C2", "text": "She needn't ___ so early; the train was delayed.", "options": {"A": "have left", "B": "leave", "C": "leaving"}, "correct_option": "A", "explanation": "Needn't have + past participle — o'tmishda qilish shart emas edi."},
    {"kind": "grammar", "level": "C2", "text": "Little ___ that he was being watched.", "options": {"A": "he knew", "B": "he did know", "C": "did he know"}, "correct_option": "C", "explanation": "Little dan keyin inversiya: little did he know."},
    {"kind": "grammar", "level": "C2", "text": "The ___ of the policy was met with resistance.", "options": {"A": "implement", "B": "implementation", "C": "implemented"}, "correct_option": "B", "explanation": "implementation oti kerak."},
    {"kind": "vocabulary", "level": "C2", "text": "To take something with a pinch of salt means to ___.", "options": {"A": "not fully believe it", "B": "add flavour", "C": "be physically cautious"}, "correct_option": "A", "explanation": "Pinch of salt — ma'lumotga shubha bilan yondashish."},
    {"kind": "vocabulary", "level": "C2", "text": "The report was ___ with errors.", "options": {"A": "rid", "B": "riddled", "C": "riddling"}, "correct_option": "B", "explanation": "Be riddled with — xatolarga to'la bo'lmoq."},
    {"kind": "vocabulary", "level": "C2", "text": "___ a precedent", "options": {"A": "make", "B": "do", "C": "set"}, "correct_option": "C", "explanation": "Set a precedent — pretsedent yaratish."},
    {"kind": "vocabulary", "level": "C2", "text": "His remarks were highly ___.", "options": {"A": "controversy", "B": "controversial", "C": "controversially"}, "correct_option": "B", "explanation": "controversial sifati kerak — bahsli."},
    {"kind": "vocabulary", "level": "C2", "text": "To bite the bullet means to ___.", "options": {"A": "endure something difficult", "B": "eat quickly", "C": "make a mistake"}, "correct_option": "A", "explanation": "Bite the bullet — qiyinchilikka chidamoq."},
    {"kind": "vocabulary", "level": "C2", "text": "The plan ___ due to lack of funding.", "options": {"A": "fell out", "B": "fell behind", "C": "fell through"}, "correct_option": "C", "explanation": "Fall through — amalga oshmaslik."},
    {"kind": "vocabulary", "level": "C2", "text": "The argument is ___; it ignores key evidence.", "options": {"A": "flawless", "B": "flawed", "C": "flowing"}, "correct_option": "B", "explanation": "Flawed — nuqsonli, xato."},
    {"kind": "vocabulary", "level": "C2", "text": "The long hours began to ___ a toll on her health.", "options": {"A": "make", "B": "do", "C": "take"}, "correct_option": "C", "explanation": "Take a toll on — zarar yetkazmoq."},
    {"kind": "vocabulary", "level": "C2", "text": "To speak off the cuff means to speak ___.", "options": {"A": "loudly", "B": "without preparation", "C": "rudely"}, "correct_option": "B", "explanation": "Off the cuff — tayyorgarliksiz, improvizatsiya qilib."},
    {"kind": "vocabulary", "level": "C2", "text": "The ___ of the two theories is striking.", "options": {"A": "convergence", "B": "converge", "C": "convergent"}, "correct_option": "A", "explanation": "convergence oti kerak — yaqinlashish."},
    {"kind": "vocabulary", "level": "C2", "text": "The novel offers a ___ portrayal of rural life.", "options": {"A": "numerate", "B": "neutral", "C": "nuanced"}, "correct_option": "C", "explanation": "Nuanced — nozik farqlari bilan, murakkab."},
    {"kind": "vocabulary", "level": "C2", "text": "To throw in the towel means to ___.", "options": {"A": "celebrate", "B": "give up", "C": "start again"}, "correct_option": "B", "explanation": "Throw in the towel — taslim bo'lmoq."},
    {"kind": "vocabulary", "level": "C2", "text": "The party decided to ___ a stance on the issue.", "options": {"A": "adopt", "B": "make", "C": "do"}, "correct_option": "A", "explanation": "Adopt a stance — pozitsiyani egallash."},
    {"kind": "vocabulary", "level": "C2", "text": "His response was ___ and avoided the real issue.", "options": {"A": "persuasive", "B": "evasive", "C": "decisive"}, "correct_option": "B", "explanation": "Evasive — ravshan javob bermaydigan, qochqin."},
    {"kind": "vocabulary", "level": "C2", "text": "The findings are ___ with the hypothesis.", "options": {"A": "consistency", "B": "consistently", "C": "consistent"}, "correct_option": "C", "explanation": "consistent sifati kerak — izchil, muvofiq."}
